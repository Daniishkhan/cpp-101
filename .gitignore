# Build directories (one per challenge: build/, build-release/, build-asan/ ...)
build*/

# Throwaway experiments: keep only the README that explains the folder
scratch/*
!scratch/README.md

# Editor / tooling caches
.vscode/
.cache/
.idea/
*.swp

# Generated by CMake; symlinked to a challenge root for clangd, never committed
compile_commands.json

# Object files and binaries
*.o
*.a
*.dSYM/

# macOS
.DS_Store

# Not expected, but just in case something pulls in node for the book
docs/book/**/node_modules/

# Python bytecode (tools/)
__pycache__/
*.pyc
